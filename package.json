{
  "name": "ascii",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build --target=bun src/main.ts --outdir dist --external @opentui/core"
  },
  "dependencies": {
    "@opentui/core": "0.6.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
